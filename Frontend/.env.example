# Where the Spring Boot API lives. Copy this file to .env.local and adjust.
VITE_API_BASE_URL=http://localhost:8080

# Signup gate for student emails. Kept configurable to mirror the backend's
# app.auth.student-email-pattern - CPUT publishes no student-number digit
# count, so this stays loose on length and strict on domain.
VITE_STUDENT_EMAIL_PATTERN=^\d{8,10}@mycput\.ac\.za$
