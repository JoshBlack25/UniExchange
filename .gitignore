
# Editor settings: share the run/debug profiles and portable workspace settings.
# Anything else VS Code drops in here stays local.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

.claude

# Secrets: environment files and per-machine / per-deployment property overrides.
# .env.example stays tracked as the template.
.env
.env.*
!.env.example
**/application-local.properties
**/application-prod-secrets.properties
